<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS-only keys merged into the app's Info.plist by Tauri at build time.
  NSMicrophoneUsageDescription is required for getUserMedia in WKWebView; without
  it, macOS denies mic access (and can terminate the app) instead of prompting.
-->
<plist version="1.0">
<dict>
  <key>NSMicrophoneUsageDescription</key>
  <string>TypeIT uses the microphone to transcribe what you say into text you can edit and send.</string>
</dict>
</plist>
